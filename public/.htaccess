RewriteEngine On

# Block environment files without relying on Apache 2.4-only directives.
RewriteRule ^\.env(?:$|/) - [F,L]

# Keep real assets available and route application URLs through the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
